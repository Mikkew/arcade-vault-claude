# Copia este archivo a .env.local y completa los valores. Solo servidor.
RESEND_API_KEY=
# Opcional. Por defecto: el correo de la cuenta de Resend (ver app/about/actions.ts).
# CONTACT_TO_EMAIL=
# Opcional. Por defecto: onboarding@resend.dev (solo entrega al correo de tu cuenta de Resend).
# CONTACT_FROM_EMAIL=

# Supabase. Estas dos son públicas por diseño (llevan NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (sin barra final). Se usa para construir el enlace de recuperación
# de contraseña; debe estar también en las URLs de redirección permitidas de Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
